// Signet Phase 0 schema. State payloads live as validated JSON (stateJson)
// parsed through @signet/contracts at the repository boundary — the DB stores,
// contracts decide. Status columns are duplicated out of the JSON for indexing.

generator client {
  provider = "prisma-client"
  output   = "../src/persistence/generated"
}

datasource db {
  provider = "postgresql"
}

model Feature {
  id         String      @id @db.Uuid
  title      String
  stage      String // INTAKE | DESIGN | DECOMPOSED | IMPLEMENTING | DONE
  // Which repository this feature is built into. Null means "whichever repo this
  // Signet instance is configured with", which is what every feature created before
  // now means — so existing rows need no backfill and behave exactly as they did.
  repoPath   String?     @map("repo_path")
  // local | github. A github repo can be surveyed and planned against out of the
  // connector's clone cache, but merging into one needs a push. Recording the origin
  // is what lets a run refuse up front with a reason, instead of failing somewhere
  // deep inside git.
  repoOrigin String      @default("local") @map("repo_origin")
  // What to show the user. An absolute cache path is noise on screen for a github
  // repo, where "owner/name" is the thing they actually picked.
  repoLabel  String?     @map("repo_label")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  increments Increment[]
  briefs     BriefVersion[]
  events     FeatureEvent[]

  @@map("features")
}

// What happened to a feature, in order: the things a person did and the things
// Signet did that no other table records with their time — when it was asked for and
// in whose words, what was proposed, what was merged as which commit, what was taken
// back. The thread reads these beside runs, questions and request versions.
model FeatureEvent {
  id          String   @id @db.Uuid
  featureId   String   @map("feature_id") @db.Uuid
  incrementId String?  @map("increment_id") @db.Uuid
  kind        String // asked | proposed | initialled | answered | sent_back | merged | taken_back
  at          DateTime @default(now()) @db.Timestamptz(3)
  payloadJson String   @default("{}") @map("payload_json")
  feature     Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@index([featureId, at])
  @@index([at])
  @@map("feature_events")
}

model BriefVersion {
  id          String   @id @db.Uuid
  featureId   String   @map("feature_id") @db.Uuid
  version     Int
  contentMd   String   @map("content_md") // PRD + answers + signed assumptions
  frozenAt    DateTime @default(now()) @map("frozen_at")
  feature     Feature  @relation(fields: [featureId], references: [id])

  @@unique([featureId, version])
  @@map("brief_versions")
}

model Increment {
  id              String   @id @db.Uuid
  featureId       String   @map("feature_id") @db.Uuid
  title           String
  status          String // mirror of stateJson.status for indexing
  stateJson       String   @map("state_json") // contracts IncrementState
  declaredSurface String[] @map("declared_surface")
  // What "done" means for this step. Defaults to empty so existing rows are
  // untouched, but a blank one is a bug being carried forward: the context pack
  // shipped acceptance.md as the empty string for every run ever made, so until
  // now no agent had ever been told what it was aiming at.
  acceptanceMd    String   @default("") @map("acceptance_md")
  briefVersionId  String   @map("brief_version_id") @db.Uuid
  repairAttempt   Int      @default(0) @map("repair_attempt")
  freshRestarts   Int      @default(0) @map("fresh_restarts")
  orderIndex      Int      @map("order_index")
  // Set on a step that takes back an earlier one: its change is the revert of that
  // step's merge. Null for every ordinary step.
  revertsIncrementId String? @map("reverts_increment_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  feature         Feature  @relation(fields: [featureId], references: [id])
  runs            Run[]

  @@index([featureId, status])
  @@map("increments")
}

model Run {
  id           String     @id @db.Uuid
  incrementId  String     @map("increment_id") @db.Uuid
  status       String // CREATED | PHASE | SUCCEEDED | FAILED | ABORTED
  stateJson    String     @map("state_json") // contracts RunState
  workspacePath String?   @map("workspace_path")
  sessionRef   String?    @map("session_ref")
  startedAt    DateTime   @default(now()) @map("started_at")
  finishedAt   DateTime?  @map("finished_at")
  increment    Increment  @relation(fields: [incrementId], references: [id])
  phases       RunPhase[]
  effects      Effect[]
  usage        UsageLedgerEntry[]

  @@index([incrementId, status])
  @@index([status]) // completer scans for orphans by status
  @@map("runs")
}

model RunPhase {
  id         String    @id @db.Uuid
  runId      String    @map("run_id") @db.Uuid
  phase      String // contracts RunPhaseName
  attempt    Int       @default(1)
  enteredAt  DateTime  @default(now()) @map("entered_at")
  completedAt DateTime? @map("completed_at")
  run        Run       @relation(fields: [runId], references: [id])

  @@unique([runId, phase, attempt]) // recovery point identity
  @@map("run_phases")
}

model Effect {
  id             String   @id @db.Uuid
  runId          String   @map("run_id") @db.Uuid
  phase          String
  kind           String // contracts EffectKind
  idempotencyKey String   @unique @map("idempotency_key")
  status         String // JOURNALED | EXECUTING | DONE | FAILED
  payloadJson    String   @map("payload_json")
  resultJson     String?  @map("result_json")
  attempt        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  run            Run      @relation(fields: [runId], references: [id])

  @@index([runId, status])
  @@map("effect_journal")
}

model OutboxMessage {
  id          String    @id @db.Uuid
  topic       String // run.dispatch | run.resume | gate.execute | notify
  payloadJson String    @map("payload_json")
  // timestamptz: the dispatcher compares these against now() in raw SQL —
  // naive timestamps break on any non-UTC server (found by live test).
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(3) // future = parked/delayed
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([processedAt, availableAt]) // dispatcher scan
  @@map("outbox")
}

model QuotaWindow {
  id         String    @id @db.Uuid
  kind       String // five_hour | weekly
  exhaustedAt DateTime? @map("exhausted_at")
  resetsAt   DateTime? @map("resets_at")
  observedAt DateTime  @default(now()) @map("observed_at")

  @@index([kind, observedAt])
  @@map("quota_windows")
}

model UsageLedgerEntry {
  id           String   @id @db.Uuid
  runId        String   @map("run_id") @db.Uuid
  model        String
  inputTokens  Int      @map("input_tokens")
  cachedInputTokens Int @default(0) @map("cached_input_tokens")
  outputTokens Int      @map("output_tokens")
  costUsd      Decimal? @map("cost_usd") @db.Decimal(10, 6)
  recordedAt   DateTime @default(now()) @map("recorded_at")
  run          Run      @relation(fields: [runId], references: [id])

  @@index([runId])
  @@map("usage_ledger")
}

model ContextPackManifest {
  id            String   @id @db.Uuid
  runId         String   @unique @map("run_id") @db.Uuid
  manifestJson  String   @map("manifest_json") // contracts ContextPackManifest
  packHash      String   @map("pack_hash")
  assembledAt   DateTime @default(now()) @map("assembled_at")

  @@map("context_pack_manifests")
}

model Escalation {
  id          String   @id @db.Uuid
  incrementId String   @map("increment_id") @db.Uuid
  status      String // RAISED | ANSWERED | BRIEF_AMENDED
  stateJson   String   @map("state_json")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([incrementId, status])
  @@map("escalations")
}

model DesignRecord {
  id                 String   @id @db.Uuid
  incrementId        String   @unique @map("increment_id") @db.Uuid
  source             String // ingested | resolved
  approvedBy         String   @map("approved_by")
  approvedAt         DateTime @map("approved_at")
  intentJson         String   @map("intent_json")
  referenceImagePath String?  @map("reference_image_path")

  @@map("design_records")
}

model Rule {
  id                String     @id @db.Uuid
  repoLabel         String     @map("repo_label")
  statement         String
  kind              String
  confidence        Float
  trend             String
  status            String // PROPOSED | CONFIRMED | REJECTED | DEMOTED | RETIRED | SUPERSEDED
  checkJson         String?    @map("check_json")
  exceptionsJson    String     @default("[]") @map("exceptions_json")
  fpCount           Int        @default(0) @map("fp_count")
  sourceFindingKind String?    @map("source_finding_kind")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  evidence          RuleEvidence[]

  @@index([repoLabel, status])
  @@map("rules")
}

model RuleEvidence {
  id     String @id @db.Uuid
  ruleId String @map("rule_id") @db.Uuid
  ref    String
  kind   String
  detail String?
  rule   Rule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@map("rule_evidence")
}

model GateVerdict {
  id          String   @id @db.Uuid
  runId       String   @map("run_id") @db.Uuid
  gate        String // typecheck | lint | tests | conformance | rules
  outcome     String // pass | fail | warn | skipped
  findingsJson String  @map("findings_json") // contracts GateVerdictView.findings
  recordedAt  DateTime @default(now()) @map("recorded_at")

  @@index([runId, gate])
  @@map("gate_verdicts")
}

// ── automation ────────────────────────────────────────────────────────────────
//
// One concept with three faces. A Recipe is a saved request: a description, a target
// repo, and optionally a fixed step plan. Fill in its blanks and it is a template;
// leave it with none and it is a one-click action. A Workflow is an ordered list of
// recipes plus a trigger.
//
// Nothing here can merge. A workflow runs work up to the point of landing it and then
// stops, because the merge signature stays human — that is the one part of the two
// signatures automation does not get to take.

model Recipe {
  id          String   @id @db.Uuid
  name        String
  /** What to build. May contain {{placeholders}}, which makes it a template. */
  goalMd      String   @map("goal_md")
  /** Target repo, same meaning as on Feature: null is the configured one. */
  repoPath    String?  @map("repo_path")
  repoOrigin  String   @default("local") @map("repo_origin")
  repoLabel   String?  @map("repo_label")
  /**
   * A fixed step plan, as JSON, for a recipe that should not be re-planned every time.
   * Null means propose the breakdown fresh on each run, which is the usual case.
   */
  stepsJson   String?  @map("steps_json")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  steps       WorkflowStep[]

  @@map("recipes")
}

model Workflow {
  id          String   @id @db.Uuid
  name        String
  /** Off by default. An automation nobody armed should never have fired. */
  enabled     Boolean  @default(false)
  /** Validated through contracts: schedule | event | manual, with its parameters. */
  triggerJson String   @map("trigger_json")
  /**
   * How many times a run of this workflow may cause another run. Event triggers can
   * cascade — a workflow reacting to a merge can create work that merges — and a
   * counter is the difference between a loop that stops and one that does not.
   */
  maxDepth    Int      @default(1) @map("max_depth")
  /** When the schedule last fired, so a restart does not replay missed windows. */
  lastFiredAt DateTime? @map("last_fired_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  steps       WorkflowStep[]
  runs        WorkflowRun[]

  @@map("workflows")
}

model WorkflowStep {
  id         String   @id @db.Uuid
  workflowId String   @map("workflow_id") @db.Uuid
  recipeId   String   @map("recipe_id") @db.Uuid
  orderIndex Int      @map("order_index")
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  recipe     Recipe   @relation(fields: [recipeId], references: [id])

  @@unique([workflowId, orderIndex])
  @@map("workflow_steps")
}

model WorkflowRun {
  id          String    @id @db.Uuid
  workflowId  String    @map("workflow_id") @db.Uuid
  /** schedule | event | manual — what actually started this, not what could have. */
  triggeredBy String    @map("triggered_by")
  /** The event that caused it, when there was one. Kept for tracing a cascade. */
  causeJson   String?   @map("cause_json")
  /** 0 for a run a human or a schedule started; +1 for each link in a cascade. */
  depth       Int       @default(0)
  status      String // running | succeeded | failed | skipped
  /** What it did, and why it stopped. The only honest record of an unattended run. */
  outcomeJson String?   @map("outcome_json")
  startedAt   DateTime  @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, startedAt])
  @@map("workflow_runs")
}
