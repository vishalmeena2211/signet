{
  "name": "@signet/contracts",
  "version": "0.0.1",
  "description": "Every shape shared between Signet's core and console, as a zod schema first and a TypeScript type inferred from it.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint src/"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@signet/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.2"
  }
}
