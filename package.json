{
  "name": "signet",
  "description": "Say what you want built. Signet plans it, writes it and checks it with your own Claude Code, and nothing reaches your main branch until you seal it.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "console": "node scripts/console.mjs",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "policy": "turbo run policy",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "check": "turbo run build check-types lint policy test"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.4",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.11"
  },
  "homepage": "https://github.com/vishalmeena2211/signet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishalmeena2211/signet.git"
  }
}
